<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Song history is a log of where you've been and what you heard, so it stays out
     of cloud backups; it still moves to a new device in a direct device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="history.xml" />
    </cloud-backup>
</data-extraction-rules>
